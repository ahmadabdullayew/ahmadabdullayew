  "component_policy": {
    "allowed": [
      "Markdown headings, prose, links, tables, lists, fenced code",
      "Repository-local SVG files in the asset registry"
    ],
    "disallowed": [
      "Externally served README images, including badges, statistics and animations",
      "Undeclared local image files",
      "Duplicate remote and locally generated activity analytics"
    ],
    "allowed_html_tags": [
      "a",
      "br",
      "h1",
      "img",
      "p",
      "picture",
      "source",
      "strong",
      "sub"
    ],
    "image_alternative_text": "Informative and functional images require descriptive alt; decorative HTML images require alt=\"\", role=\"presentation\" and aria-hidden=\"true\" and cannot be linked; theme-variant source elements inherit the img fallback alternative.",
    "local_links": "Local link destinations must resolve inside repository; README and Markdown fragment anchors must exist.",
    "visual_policy": "Text-first profile; ordinary h3 featured-project headings; no SMIL/CSS motion; static desktop/mobile activity visuals with accessible Markdown equivalent."
  }
}
